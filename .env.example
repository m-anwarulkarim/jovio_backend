# ─── Server ───────────────────────────────────────────────────
PORT=5000

# Local:  http://localhost:5000
# Render: https://jovio-backend.onrender.com
APP_URL=http://localhost:5000

# ─── Better Auth ──────────────────────────────────────────────
# Must match APP_URL exactly (no trailing slash)
# Local:  http://localhost:5000
# Render: https://jovio-backend.onrender.com
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_SECRET=your_strong_random_secret_here

# ─── Frontend ─────────────────────────────────────────────────
# Local:  http://localhost:3000
# Vercel: https://jovio-frontend.vercel.app
FRONTEND_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/jovio

# ─── Cloudinary ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_jwt_secret
JWT_ACCESS_EXPIRES_IN=1h
PUBLIC_CHAT_SECRET=your_public_chat_secret

# ─── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Google OAuth ─────────────────────────────────────────────
# Google Cloud Console → Credentials → OAuth 2.0 Client IDs
#
# Authorized JavaScript origins:
#   http://localhost:5000
#   https://jovio-backend.onrender.com
#
# Authorized redirect URIs:
#   http://localhost:5000/api/auth/callback/google
#   https://jovio-backend.onrender.com/api/auth/callback/google
#
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
